        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "応援ありがとうございます！GitHub で MouseSpell に Star を付けることもできます。"
          }
        }
      }
    },
    "support.thanks.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your support keeps MouseSpell going. You made a dragon maid very happy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的支持让 MouseSpell 走得更远，龙女仆也开心得跳起来了。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "応援が MouseSpell の開発を支えます。ドラゴンメイドも大喜びです。"
          }
        }
      }
    },
    "support.thanks.title": {
