    "common.disabled.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MouseSpell is paused. Turn on to use your shortcuts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MouseSpell 已暂停，开启后快捷键恢复生效"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MouseSpell は一時停止中です。オンにするとショートカットを使えます。"
          }
        }
      }
    },
    "common.enable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にする"
          }
        }
      }
    },
    "common.enabled.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MouseSpell is on. Turn off to pause all shortcuts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MouseSpell 已开启，关闭后所有快捷键暂停"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MouseSpell は有効です。オフにするとすべてのショートカットを一時停止します。"
          }
        }
      }
    },
    "common.off": {
      "extractionState": "manual",
      "localizations": {
