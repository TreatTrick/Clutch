    "payment.alipay.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan with Alipay to tip any amount."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用支付宝扫一扫，金额随意。"
