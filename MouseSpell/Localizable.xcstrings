        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三指下滑"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3本指で下にスワイプ"
          }
        }
      }
    },
    "gesture.missionControl": {
      "extractionState": "manual",
      "localizations": {
