    "list.hotkeyDisabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The matching shortcut is turned off in System Settings › Keyboard › Keyboard Shortcuts › Mission Control."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对应的系统快捷键已关闭，请在“系统设置 › 键盘 › 键盘快捷键 › 调度中心”中开启"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応するショートカットが無効です。「システム設定 › キーボード › キーボードショートカット › Mission Control」で有効にしてください。"
          }
        }
      }
    },
    "list.remove": {
      "extractionState": "manual",
      "localizations": {
