    },
    "support.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MouseSpell is free and open source. A small tip helps it go further."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MouseSpell 免费开源，一点小小的打赏，就能让它走得更远。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MouseSpell は無料でオープンソースです。少しの支援が、これからの開発を支えます。"
          }
        }
      }
    },
    "support.supported.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thank you! You can still visit GitHub and give MouseSpell a Star."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "感谢支持！仍可打开 GitHub 为 MouseSpell 点 Star。"
