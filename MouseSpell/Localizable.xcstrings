    "permission.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MouseSpell needs this to notice when you hold a key and press a mouse button in any app. Turn on MouseSpell in the list that opens."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MouseSpell 需要它来识别你在任意应用中按住键盘并按下鼠标按键的操作。请在打开的列表中开启 MouseSpell。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのアプリでもキーとマウスボタンの同時操作を検出するために必要です。表示される一覧で MouseSpell をオンにしてください。"
          }
        }
      }
    },
    "permission.grant": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open System Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开系统设置"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定を開く"
          }
        }
      }
    },
    "permission.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MouseSpell never records what you type."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MouseSpell 不会记录你输入的任何内容"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MouseSpell は入力内容を記録しません。"
          }
        }
      }
    },
    "permission.reopen": {
      "extractionState": "manual",
