    "app.tagline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold a key, press a mouse button, trigger a system gesture"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住键盘按键，再按鼠标按键，触发系统手势"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーを押しながらマウス操作でジェスチャを実行"
          }
        }
      }
    },
