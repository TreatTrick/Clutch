    "recorder.key.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the key you'll hold with your other hand"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用时，用另一只手按住这个键"
          }
        }
      }
    },
    "recorder.key.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press one of these keys"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下其中任意一个键"
          }
        }
      }
    },
    "recorder.mouse.conflict %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already used for “%@”. Try another button."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个组合已用于“%@”，换一个按键试试"
          }
        }
      }
    },
    "recorder.mouse.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Side buttons, middle click, right click, or scroll the wheel"
