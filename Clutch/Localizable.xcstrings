    "recorder.done.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcut added"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
