    "permission.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clutch needs this to notice when you hold a key and press a mouse button in any app. Turn on Clutch in the list that opens."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Clutch 需要它来识别你在任意应用中按住键盘并按下鼠标按键的操作。请在打开的列表中开启 Clutch。"
          }
        }
      }
    },
    "permission.grant": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open System Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开系统设置"
          }
        }
      }
    },
    "permission.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clutch never records what you type."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Clutch 不会记录你输入的任何内容"
          }
        }
      }
    },
    "permission.reopen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open System Settings Again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再次打开系统设置"
          }
        }
      }
    },
    "permission.reset": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove the old entry and try again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除旧的授权记录并重新授权"
          }
        }
      }
    },
    "permission.stuck": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already turned on but still waiting? An older copy of Clutch may be the one in the list."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已经打开了却还在等待？列表里的可能是旧版本的 Clutch。"
          }
        }
      }
    },
    "permission.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Clutch to use Accessibility"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 Clutch 使用辅助功能"
          }
        }
      }
    },
    "permission.waiting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for permission… Clutch continues automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待授权中… 授权后会自动继续"
          }
        }
      }
    },
    "recorder.action.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose what it does"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择要触发的操作"
          }
        }
      }
    },
    "recorder.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上一步"
          }
        }
      }
    },
    "recorder.back.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go back one step (Esc)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回上一步（Esc）"
          }
