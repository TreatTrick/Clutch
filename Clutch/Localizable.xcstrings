    "app.tagline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold a key, press a mouse button, trigger a system gesture"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住键盘按键，再按鼠标按键，触发系统手势"
          }
        }
      }
    },
    "common.disabled.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clutch is paused. Turn on to use your shortcuts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Clutch 已暂停，开启后快捷键恢复生效"
          }
        }
      }
    },
    "common.enable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用"
