{
	"name": "mousespell-website",
	"private": true,
	"version": "0.0.1",
	"packageManager": "pnpm@10.14.0",
	"engines": { "node": ">=22.12.0" },
	"type": "module",
	"scripts": {
		"dev": "node scripts/prepare-assets.mjs && vite dev",
		"build": "node scripts/prepare-assets.mjs && vite build",
		"preview": "vite preview",
		"test": "node --experimental-strip-types --test tests/*.test.mjs",
		"prepare": "svelte-kit sync",
		"check": "node scripts/prepare-assets.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
